# ================================
# Unity Project .gitattributes (No LFS)
# ================================

# --- Text files (코드, 설정 등) ---
*.cs          text eol=lf
*.shader      text eol=lf
*.cginc       text eol=lf
*.hlsl        text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.txt         text eol=lf
*.md          text eol=lf
*.ini         text eol=lf

# --- Unity 에셋 (텍스트 기반) ---
*.asset       text eol=lf
*.unity       text eol=lf
*.prefab      text eol=lf
*.mat         text eol=lf
*.anim        text eol=lf
*.controller  text eol=lf
*.overrideController text eol=lf
*.meta        text eol=lf
*.guiskin     text eol=lf
*.mask        text eol=lf
*.renderTexture text eol=lf
*.terrainlayer text eol=lf

# --- Binary assets (이미지, 모델, 오디오 등) ---
*.psd         binary
*.fbx         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.tga         binary
*.tif         binary
*.bmp         binary
*.wav         binary
*.mp3         binary
*.ogg         binary
*.mp4         binary
*.mov         binary
*.avi         binary
*.exr         binary
*.hdr         binary
*.ttf         binary
*.otf         binary
*.dll         binary
*.exe         binary
*.zip         binary
*.7z          binary
*.tar         binary
*.gz          binary
*.unitypackage binary

# --- 기본 설정 ---
* text=auto
